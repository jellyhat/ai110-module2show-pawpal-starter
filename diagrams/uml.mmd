classDiagram
    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +addTask(task)
        +getTasks()
    }

    class Task {
        +String title
        +int durationMinutes
        +String priority
        +String frequency
        +Time dueTime
        +bool isComplete
        +markComplete()
    }

    class Owner {
        +String name
        +List~String~ preferences
        +List~Pet~ pets
        +addPet(pet)
        +getAllTasks() List~PetTask~
    }

    class PetTask {
        +Pet pet
        +Task task
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +Time startTime
    }

    class SkippedTask {
        +Pet pet
        +Task task
        +String reason
    }

    class SchedulePlan {
        +List~ScheduledTask~ scheduled
        +List~SkippedTask~ skipped
        +int availableMinutes
        +Time dayStart
    }

    class Scheduler {
        +buildDailyPlan(owner, availableMinutes, dayStart) SchedulePlan
        +organizeTasks(petTasks, availableMinutes, dayStart, preferences) SchedulePlan
        +explainPlan(plan) String
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler ..> Owner : retrieves tasks across pets
    Owner ..> PetTask : returns pet-task pairs
    SchedulePlan "1" *-- "0..*" ScheduledTask : includes
    SchedulePlan "1" *-- "0..*" SkippedTask : explains omissions
    ScheduledTask --> Pet
    ScheduledTask --> Task
    SkippedTask --> Pet
    SkippedTask --> Task
