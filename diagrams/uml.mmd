classDiagram
    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +addTask(task)
        +getTasks()
    }

    class Task {
        +String title
        +int durationMinutes
        +String priority
        +String frequency
        +String time
        +bool isComplete
        +markComplete()
    }

    class Owner {
        +String name
        +List~String~ preferences
        +List~Pet~ pets
        +addPet(pet)
        +getAllTasks()
    }

    class Scheduler {
        +buildDailyPlan(owner, availableMinutes)
        +organizeTasks(tasks, availableMinutes)
        +explainPlan()
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler ..> Owner : retrieves tasks across pets
