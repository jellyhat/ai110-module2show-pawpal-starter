classDiagram
    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +addTask(task)
        +completeTask(task, completedOn) Task
        +getTasks()
    }

    class Task {
        +String title
        +int durationMinutes
        +String priority
        +String frequency
        +Time dueTime
        +bool isComplete
        +Date startsOn
        +Date completedOn
        +markComplete()
    }

    class Owner {
        +String name
        +List~String~ preferences
        +List~Pet~ pets
        +addPet(pet)
        +getAllTasks(petName, status, asOfDate) List~PetTask~
    }

    class PetTask {
        +Pet pet
        +Task task
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +Time startTime
    }

    class SkippedTask {
        +Pet pet
        +Task task
        +String reason
    }

    class SchedulePlan {
        +List~ScheduledTask~ scheduled
        +List~SkippedTask~ skipped
        +int availableMinutes
        +Time dayStart
    }

    class Scheduler {
        +sortByTime(tasks) List~Task~
        +filterTasks(petTasks, petName, status, asOfDate) List~PetTask~
        +detectConflicts(scheduledTasks) List~String~
        +buildDailyPlan(owner, availableMinutes, dayStart, petName, status, scheduleDate) SchedulePlan
        +organizeTasks(petTasks, availableMinutes, dayStart, preferences, petName, status, scheduleDate) SchedulePlan
        +explainPlan(plan) String
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler ..> Owner : retrieves tasks across pets
    Owner ..> PetTask : returns pet-task pairs
    SchedulePlan "1" *-- "0..*" ScheduledTask : includes
    SchedulePlan "1" *-- "0..*" SkippedTask : explains omissions
    ScheduledTask --> Pet
    ScheduledTask --> Task
    SkippedTask --> Pet
    SkippedTask --> Task
